# ─── Base de datos ────────────────────────────────────────────────────────────
# Railway lo provee automáticamente al agregar el plugin PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia_esto_por_un_secreto_aleatorio
# URL pública de la app (Railway te la da al hacer deploy)
AUTH_URL=https://tu-app.railway.app

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=HelpDesk OS <soporte@tudominio.com>

# ─── IA (wizard de configuración) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
