// HelpDesk OS — Esquema de Base de Datos
// Bloque 1: Tablas base del sistema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenants (Empresas) ───────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // ej: "altra" → helpdesk.altra.com
  domain    String?           // dominio propio (opcional)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  tickets         Ticket[]
  assets          Asset[]
  categories      Category[]
  channels        Channel[]
  groups          Group[]
  invitations     UserInvitation[]
  settings        TenantSettings?
  cannedResponses CannedResponse[]
  networkDevices  NetworkDevice[]
  dvrs            Dvr[]
  dvrCredential   DvrCredential?
  dvrScanJobs     DvrScanJob[]
  monitorTargets  MonitorTarget[]
  monitorChecks   MonitorCheck[]

  @@map("tenants")
}

// ─── Usuarios ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role           UserRole @default(USER)
  passwordHash   String?           // null para usuarios creados por admin sin contraseña aún
  emailSignature String?           // firma que se añade al pie de respuestas por email
  createdAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  ticketsCreated  Ticket[]        @relation("CreatedBy")
  ticketsAssigned Ticket[]        @relation("AssignedTo")
  messages        TicketMessage[]
  groups          GroupMember[]

  @@unique([tenantId, email])
  @@map("users")
}

enum UserRole {
  ADMIN  // administra el sistema
  AGENT  // atiende tickets
  USER   // usuario final que crea tickets
}

// ─── Tickets ──────────────────────────────────────────────────────────────────

model Ticket {
  id             String       @id @default(cuid())
  tenantId       String
  number         Int
  title          String
  status         TicketStatus @default(NEW)
  priority       Priority     @default(MEDIUM)
  type           TicketType   @default(INCIDENT)
  impact         ImpactLevel  @default(LOW)
  categoryId     String?
  subcategory    String?      // subcategoría libre
  area           String?      // área / departamento
  location       String?      // sede / ubicación
  affectedSystem String?      // sistema o aplicación afectada
  appVersion     String?      // versión de la aplicación
  siteType         String?      // tipo de sede: OFFICE | POS
  requesterName    String?      // nombre del usuario que reportó el problema
  requesterContact String?      // email o teléfono del solicitante
  equipmentName    String?      // equipo afectado: Desktop, Portátil, POS Principal, etc.
  deviceType       String?      // componente: Pantalla, CPU, Software, etc.
  deviceDetail     String?      // detalle libre: cuál SO, cuál software, cuál otro
  createdById    String
  assignedToId   String?
  assetId        String?
  solution       String?      // resultado / solución al cerrar
  slaDeadline    DateTime?    // fecha límite según prioridad
  slaBreached    Boolean      @default(false)
  // ── Campos vista TI ──────────────────────────────────────────────────────────
  techCategory    String?     // categoría técnica TI
  affectedAsset   String?     // activo / CI afectado (texto libre)
  assignedGroup   String?     // grupo asignado (Mesa de ayuda, Campo, etc.)
  urgency         String?     // urgencia: LOW / MEDIUM / HIGH / CRITICAL
  diagnosis       String?     // causa / diagnóstico
  // ── Campos vista usuario final ────────────────────────────────────────────────
  whatNeeded      String?     // ¿Qué necesitas? (lenguaje simple)
  affectedService String?     // equipo o servicio afectado (simple)
  createdFromUserView Boolean @default(false) // true si lo creó un usuario final
  // ── Campos para tickets creados desde email ────────────────────────────────────
  emailFrom      String?     // dirección de email del remitente
  emailMessageId String?     // Message-ID del email original (para deduplicación)
  groupId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  closedAt       DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  category   Category?       @relation(fields: [categoryId], references: [id])
  createdBy  User            @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  asset      Asset?          @relation(fields: [assetId], references: [id])
  group      Group?          @relation(fields: [groupId], references: [id])
  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@unique([tenantId, number])
  @@map("tickets")
}

enum TicketStatus {
  NEW               // nuevo
  ASSIGNED          // asignado
  IN_DIAGNOSIS      // en diagnóstico
  IN_ANALYSIS       // en análisis
  IN_PROGRESS       // en curso
  WAITING           // en espera
  PENDING_USER      // pendiente de usuario
  PENDING_PROVIDER  // pendiente de proveedor
  ESCALATED         // escalado
  RESOLVED          // resuelto
  CLOSED            // cerrado
}

enum TicketType {
  INCIDENT           // incidencia
  REQUEST            // solicitud
  ACCESS_PERMISSIONS // acceso y permisos
  PURCHASE           // compra / insumo
  QUERY              // consulta
  PROBLEM            // problema
  CHANGE             // cambio
}

enum ImpactLevel {
  LOW       // solo el usuario
  MEDIUM    // área / departamento
  HIGH      // múltiples áreas
  CRITICAL  // toda la empresa
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Respuestas predefinidas ──────────────────────────────────────────────────

model CannedResponse {
  id        String   @id @default(cuid())
  tenantId  String
  title     String   // nombre corto visible en el picker
  body      String   // texto completo de la respuesta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("canned_responses")
}

// ─── Adjuntos de Ticket ───────────────────────────────────────────────────────

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  name      String   // nombre original del archivo
  key       String   // clave en R2
  url       String   // URL pública
  size      Int      // tamaño en bytes
  mimeType  String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

// ─── Mensajes de Ticket ───────────────────────────────────────────────────────

model TicketMessage {
  id         String         @id @default(cuid())
  ticketId   String
  userId     String?
  body       String
  channel    MessageChannel @default(WEB)
  isInternal Boolean        @default(false) // nota interna, no visible al usuario
  createdAt  DateTime       @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("ticket_messages")
}

enum MessageChannel {
  WEB       // portal web
  EMAIL     // correo
  WHATSAPP  // WhatsApp
  PHONE     // llamada (registro manual)
}

// ─── Activos / Inventario ─────────────────────────────────────────────────────

model Asset {
  id           String      @id @default(cuid())
  tenantId     String
  name         String
  type         AssetType
  serialNumber String?
  brand        String?
  model        String?
  status       AssetStatus @default(ACTIVE)
  purchasedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Campos de gestión manual
  assetNumber  String?  // número de activo / etiqueta (ej: DYC-001)
  location     String?  // sede, tienda o área donde está el equipo

  // Agent-collected hardware fields
  hostname     String?
  username     String?
  ipAddress    String?
  macAddress   String?
  osName       String?
  cpu          String?
  ramGB        Int?
  diskInfo     String?
  motherboard  String?
  agentVersion String?
  lastSeenAt   DateTime?
  hardwareData Json?

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]

  @@map("assets")
}

enum AssetType {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  PRINTER
  SERVER
  NETWORK
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

// ─── Categorías ───────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?  // hex color para la UI
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]

  @@unique([tenantId, name])
  @@map("categories")
}

// ─── Canales de Comunicación ──────────────────────────────────────────────────

model Channel {
  id        String      @id @default(cuid())
  tenantId  String
  type      ChannelType
  config    Json        // config específica por tipo
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
  @@map("channels")
}

enum ChannelType {
  EMAIL
  WHATSAPP_BAILEYS
  WHATSAPP_META
  PHONE
  TEAMS
}

// ─── Configuración del tenant ─────────────────────────────────────────────────

model TenantSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  userViewConfig  Json     @default("{}")
  agentViewConfig Json     @default("{}")
  agentToken      String?  // unique token for agent authentication
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

// ─── Grupos / Equipos ─────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String?  @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  members GroupMember[]
  tickets Ticket[]

  @@unique([tenantId, name])
  @@map("groups")
}

model GroupMember {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model UserInvitation {
  id        String    @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role      UserRole  @default(AGENT)
  groupId   String?
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("user_invitations")
}

// ─── Emails procesados (para deduplicación IMAP) ─────────────────────────────

model ProcessedEmail {
  id        String   @id @default(cuid())
  tenantId  String
  messageId String   // valor del header Message-ID del email
  ticketId  String?  // ticket creado (null si fue añadido como respuesta)
  createdAt DateTime @default(now())

  @@unique([tenantId, messageId])
  @@map("processed_emails")
}

// ─── Dispositivos de Red (Network Discovery) ──────────────────────────────────

model NetworkDevice {
  id          String   @id @default(cuid())
  tenantId    String
  scanId      String
  scannedFrom String
  subnet      String?
  ip          String
  mac         String?
  vendor      String?
  hostname    String?
  deviceType  String   @default("unknown")
  openPorts   Json?
  httpTitle   String?
  onvif       Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, ip])
  @@map("network_devices")
}

// ─── Monitor (Zabbix-style LAN/WAN monitoring) ───────────────────────────────

model MonitorTarget {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  host        String           // IP o dominio a monitorear
  checkType   String           // "http" | "https" | "tcp" | "ping"
  port        Int?             // override; sino usa default según checkType
  httpPath    String    @default("/")
  interval    Int       @default(60)    // segundos entre checks
  timeout     Int       @default(5000)  // ms de timeout por check
  retries     Int       @default(2)     // reintentos antes de marcar "down"
  enabled     Boolean   @default(true)
  networkType String    @default("wan") // "lan" | "wan"
  agentHost   String?                   // para lan: hostname del agente que lo chequea

  // Estado actual (desnormalizado para lectura rápida)
  status      String    @default("unknown") // "up" | "down" | "timeout" | "unknown"
  lastChecked DateTime?
  lastLatency Int?      // ms
  lastError   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  checks  MonitorCheck[]

  @@index([tenantId])
  @@index([tenantId, networkType])
  @@map("monitor_targets")
}

model MonitorCheck {
  id         String   @id @default(cuid())
  tenantId   String
  targetId   String
  status     String   // "up" | "down" | "timeout"
  latency    Int?     // ms; null si no hubo respuesta
  httpStatus Int?     // código HTTP si aplica
  error      String?
  checkedAt  DateTime @default(now())
  checkedBy  String   @default("server") // "server" o hostname del agente LAN

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  target  MonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, checkedAt(sort: Desc)])
  @@index([tenantId, checkedAt(sort: Desc)])
  @@map("monitor_checks")
}

// ─── DVRs / NVRs ─────────────────────────────────────────────────────────────

model DvrCredential {
  id        String @id @default(cuid())
  tenantId  String @unique
  username  String @default("admin")
  password  String // cifrada con AES antes de guardar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("dvr_credentials")
}

model Dvr {
  id          String    @id @default(cuid())
  tenantId    String
  name        String                        // nombre descriptivo ej: "Sede Norte - Bodega"
  serial      String?                       // número de serie Dahua (para acceso remoto P2P)
  ip          String                        // IP pública (si tiene) o IP local como fallback
  localIp     String?                       // IP local 192.168.x.x (acceso dentro de la red)
  localPort   Int       @default(37777)     // puerto local Dahua (37777 por defecto)
  port        Int       @default(80)        // puerto HTTP para API (80 por defecto)
  channels    Int       @default(8)         // 8 / 16 / 32
  username    String?                       // credencial propia (si es null usa la global)
  password    String?                       // cifrada con AES (si es null usa la global)
  location    String?                       // sede / dirección
  notes       String?
  photoUrl    String?                       // foto de la sede / equipo (URL en R2)
  status      DvrStatus @default(UNKNOWN)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, ip])
  @@map("dvrs")
}

enum DvrStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

// ─── Trabajos de scan local de DVR ───────────────────────────────────────────

model DvrScanJob {
  id        String   @id @default(cuid())
  tenantId  String
  dvrId     String
  channels  Json                        // int[]
  date      String
  startTime String   @default("00:00")
  endTime   String   @default("23:59")
  status    String   @default("pending") // pending | done | error
  results   Json?                       // grabaciones encontradas
  error     String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("dvr_scan_jobs")
}
